# Copy to .env.import.local (repo root) and fill in — used ONLY by scripts/import-items.mjs,
# never by the web app. Dashboard → Project Settings → API.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# service_role key (NOT anon) — this bypasses Row Level Security to bulk-write.
# Never put this in web/.env.local or anything VITE_-prefixed.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
